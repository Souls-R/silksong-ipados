# Allow source and documentation only. Build outputs belong outside this repo.
*
!/.gitignore
!/.gitattributes
!/README.md
!/README_EN.md
!/LICENSE
!/.github/
/.github/*
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/bug_report.md
!/build.py
!/requirements.txt
!/scripts/
!/scripts/*.py
!/scripts/*.rb
!/src/
/src/*
!/src/runtime/
!/src/runtime/*.cs
!/src/runtime/*.mm
!/src/runtime/*.h
!/src/launch/
!/src/launch/strings.json
!/tests/
!/tests/*.py
!/tests/*.cs
!/tests/*.cpp
!/src/mods/
!/src/mods/*.cs
!/tools/
/tools/*
!/tools/ModWeaver/
/tools/ModWeaver/*
!/tools/ModWeaver/*.cs
!/tools/ModWeaver/*.csproj
!/third_party/
/third_party/*
!/third_party/silksong-android/
/third_party/silksong-android/*
!/third_party/silksong-android/LICENSE
!/third_party/silksong-android/SOURCE.json
!/third_party/silksong-android/mod-weaver/
!/third_party/silksong-android/mod-weaver/*.cs
!/third_party/silksong-android/bepinex-shim/
!/third_party/silksong-android/bepinex-shim/bepinex/
!/third_party/silksong-android/bepinex-shim/bepinex/*.cs
!/third_party/silksong-android/bepinex-shim/harmony/
!/third_party/silksong-android/bepinex-shim/harmony/*.cs
